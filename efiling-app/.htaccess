Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header set X-Frame-Options "DENY"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "\.(sql|log|md)$">
  Require all denied
</FilesMatch>

<Files "config.php">
  <RequireAll>
    Require all granted
  </RequireAll>
</Files>
